import pandas as pd
import numpy as np
from scipy.stats import mannwhitneyu
from pathlib import Path

# Set up relative paths
BASE_DIR = Path(__file__).resolve().parent.parent
RESULTS_DIR = BASE_DIR / "results"

networks = ["mandl", "mumford0"]

for net in networks:
    file_path = RESULTS_DIR / f"run_level_results_{net}.csv"

    if not file_path.exists():
        print(f"File not found: {file_path}. Skipping...")
        continue

    print(f"\n=======================================================")
    print(f"--- Statistical Results (Mann-Whitney U) for {net.upper()} ---")
    print(f"=======================================================")

    df = pd.read_csv(file_path, encoding='utf-8')
    isa_ma_data = df['ISA-MA'].values
    n1 = len(isa_ma_data)

    for baseline in ['GA', 'MA-Random', 'MA-Fixed', 'MA-AOS']:
        if baseline not in df.columns:
            continue

        baseline_data = df[baseline].values
        n2 = len(baseline_data)
        N = n1 + n2

        # Mann-Whitney U test
        stat, p_value = mannwhitneyu(isa_ma_data, baseline_data, alternative='two-sided')

        # Calculate Exact Z-statistic and effect size
        mu_U = (n1 * n2) / 2
        sigma_U = np.sqrt((n1 * n2 * (N + 1)) / 12)
        z_stat = (stat - mu_U) / sigma_U
        effect_size_r = abs(z_stat) / np.sqrt(N)

        # 95% Confidence Interval
        diffs = [x - y for x in isa_ma_data for y in baseline_data]
        diffs = np.sort(diffs)
        k = int(np.round((n1 * n2 / 2) - (1.96 * sigma_U)))
        ci_lower = diffs[k]
        ci_upper = diffs[len(diffs) - k - 1]

        print(f"ISA-MA vs {baseline}:")
        print(f"  Exact p-value: {p_value:.3e}")
        print(f"  Effect Size (r): {effect_size_r:.3f}")
        print(f"  95% CI of Difference: [{ci_lower:.2f}, {ci_upper:.2f}]\n")
